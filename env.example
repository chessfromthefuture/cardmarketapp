# Backend Environment Variables
PORT=3001
NODE_ENV=development

# Cardmarket API (Optional - for live data)
MKM_APP_TOKEN=your_app_token_here
MKM_APP_SECRET=your_app_secret_here
MKM_ACCESS_TOKEN=your_access_token_here
MKM_ACCESS_SECRET=your_access_secret_here

# TCGCSV URL (Optional - for price updates)
TCGCSV_URL=https://example.com/prices.csv

# Frontend Environment Variables (for Vercel)
VITE_API_URL=http://localhost:3001
