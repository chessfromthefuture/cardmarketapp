{
  "name": "cardmarketapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://cardmarketapp.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/chessfromthefuture/cardmarketapp.git"
  },
  "bugs": {
    "url": "https://github.com/chessfromthefuture/cardmarketapp/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node server/index.cjs",
    "dev:all": "concurrently -n WEB,API -c green,cyan \"vite\" \"node server/index.cjs\"",
    "scrape:cards": "node server/card-image-scraper.cjs",
    "test:ocr": "node server/card-ocr.cjs",
    "start": "node server/index.cjs",
    "postbuild": "echo 'Build completed successfully!'",
    "install:backend": "npm install --only=production --ignore-scripts",
    "railway:build": "echo 'Skipping frontend build for Railway'",
    "railway:start": "node server/index.cjs"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "form-data": "^4.0.4",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.4",
    "tesseract.js": "^5.1.0",
    "canvas": "^2.11.2",
    "jimp": "^0.22.10"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "vite": "^5.4.8"
  }
}
